# AgentGuard environment variables.
# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# NEAR account keys are NOT stored here: they live in ~/.near-credentials/testnet/ (near CLI).

# --- Network ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# --- Testnet accounts (public ids, not secrets) ---
FACTORY_ACCOUNT_ID=agentguard.testnet
OWNER_ACCOUNT_ID=agentguard-user.testnet
SHOP_ACCOUNT_ID=agentguard-shop.testnet
EVIL_ACCOUNT_ID=agentguard-evil.testnet
# Filled in after the factory creates Sentinel's vault, e.g. sentinel.agentguard.testnet
SENTINEL_VAULT_ID=

# --- Agent key (function-call key on the vault, method request_payment only) ---
# Created later by add_agent. It can't transfer, withdraw or change rules.
AGENT_PRIVATE_KEY=

# --- NEAR AI Cloud (Sentinel's brain, TEE attestation) ---
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# TEE model, $0.30 in / $1.20 out per 1M tokens
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- Backup LLM providers (OpenAI-compatible) ---
NEBIUS_API_KEY=
# Backup 1: same DeepSeek model as NEAR AI (not TEE)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DGRID_API_KEY=
DGRID_BASE_URL=https://api.dgrid.ai/v1
DGRID_MODEL=openai/gpt-5-nano

# --- Optional, later ---
# NearBlocks API (account age/activity for address checks; works without a key but rate-limited)
NEARBLOCKS_API_KEY=
# Aurora Intents / 1Click (Day 10 payouts, mainnet only, quotes only unless approved)
AURORA_INTENTS_API_KEY=
ONECLICK_JWT=

# --- Web/server ---
PORT=3000
# Per-visitor limit for the "try to trick me" chat (protects LLM credits)
TRICK_ME_MAX_PER_HOUR=10
