{
  "name": "@agentguard/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets any AI agent pay through an AgentGuard vault on NEAR: limits enforced on-chain, not by the agent",
  "license": "MIT",
  "type": "module",
  "bin": { "agentguard-mcp": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "near-api-js": "7.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
