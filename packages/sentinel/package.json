{
  "name": "@agentguard/sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel: an AI agent that lives on an AgentGuard vault, pays for its own thinking, and invites the internet to try to rob it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
