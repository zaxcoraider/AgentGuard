    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@phala/dcap-qvl": "0.7.0",
    "ethers": "6.17.0",
    "near-api-js": "7.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
